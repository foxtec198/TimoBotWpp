PORT=3000
HOST=127.0.0.1
API_KEY=troque-essa-chave
PUPPETEER_HEADLESS=true
# Opcional. No Windows local, o servidor tenta achar o Chrome automaticamente.
# Na VPS, deixe vazio ou informe o caminho do Chrome/Chromium se necessário.
CHROME_EXECUTABLE_PATH=
QUEUE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
MESSAGE_QUEUE_NAME=whatsapp-messages
MESSAGE_QUEUE_CONCURRENCY=1
MESSAGE_QUEUE_ATTEMPTS=5
MESSAGE_QUEUE_BACKOFF_MS=5000
JSON_BODY_LIMIT=25mb
